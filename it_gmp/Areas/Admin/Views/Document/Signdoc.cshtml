@{
    ViewData["Title"] = "Receive";
    Layout = "~/Views/Shared/_Admin.cshtml";
}
<div class="row clearfix">

    <div class="page-title-box col-12">
        <div class="float-left">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="javascript:void(0);">Hệ thống</a></li>
                <li class="breadcrumb-item"><a href="javascript:void(0);">Hồ sơ</a></li>
                <li class="breadcrumb-item active">Đã ký tên</li>
            </ol>
        </div>
    </div>
    <div class="col-12">
        <section class="card card-fluid">
            <div class="card-body">
                <div class="table-responsive-md">
                    <div class="d-flex mb-2">
                        <div class="custom-control custom-switch switch-primary">
                            <input type="checkbox" class="custom-control-input filter_cancle" id="customSwitchPrimary"
                                   value="true">
                            <label class="custom-control-label" for="customSwitchPrimary">Bỏ qua hồ sơ hủy</label>
                        </div>
                        <div class="ml-auto">
                            <button class="btn btn-sm btn-success read_all" href='/admin/document/read_all?type=signdoc' title='Đọc tất cả?' data-type='confirm'>Đánh dấu đọc tất cả</button>
                        </div>
                    </div>
                    <table id="quanlytin" class="table table-striped table-bordered table-hover" cellspacing="0" width="100%">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Hồ sơ</th>
                                <th>Người ký</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </div>

    <!-- Template popover -->
    <div id="tplDropdown" style="display:none;">
        <div class="dropdown-menu p-3 shadow" style="min-width:700px">

            <form class="formtimkiem">
                <div class="boloc row mb-2 align-items-center">
                    <div class="col-md-4">Lọc theo: <b>Code</b></div>
                    <div class="col-md-8">
                        <input class="form-control form-control-sm code" />
                    </div>
                </div>
                <div class="boloc row mb-2 align-items-center">
                    <div class="col-md-4">Lọc theo: <b>Mã hồ sơ</b></div>
                    <div class="col-md-8">
                        <input class="form-control form-control-sm mahoso" />
                    </div>
                </div>
                <div class="boloc row mb-2 align-items-center">
                    <div class="col-md-4">Lọc theo: <b>Tiêu đề</b></div>
                    <div class="col-md-8">
                        <input class="form-control form-control-sm name_vi" />
                    </div>
                </div>
                <div class="boloc row mb-2 align-items-center">
                    <div class="col-md-4">Lọc theo: <b>Độ ưu tiên</b></div>
                    <div class="col-md-8">
                        <select class='form-control form-control-sm search_priority'>
                            <option value='0' selected></option>
                            <option value='1'>Thấp</option>
                            <option value='2'>Trung bình</option>
                            <option value='3'>Cao</option>
                        </select>
                    </div>
                </div>

                <div class="boloc row mb-2 align-items-center">
                    <div class="col-md-4">Lọc theo: <b>Trạng thái</b></div>
                    <div class="col-md-8">
                        <select class='form-control form-control-sm search_status'>
                            <option value='0' selected></option>
                            <option value='1'>Tạo mới</option>
                            <option value='2'>Trình ký</option>
                            <option value='3'>Hủy</option>
                            <option value='4'>Đã ký xong</option>
                            <option value='6'>Hiện hành</option>
                            <option value='8'>Obsoleted</option>
                        </select>
                    </div>
                </div>

                <div class="boloc row mb-2 align-items-center">
                    <div class="col-md-4">Lọc theo: <b>Loại hồ sơ</b></div>
                    <div class="col-md-8">
                        <select class='form-control form-control-sm search_type_option'>
                        </select>
                    </div>
                </div>

                <div class="boloc row mb-2 align-items-center">
                    <div class="col-md-4">Lọc theo: <b>Người tạo</b></div>
                    <div class="col-md-8">
                        <input class="form-control form-control-sm nguoitao" />
                    </div>
                </div>

                <div class="boloc row mb-2 align-items-center">
                    <div class="col-md-4">Lọc theo: <b>Ngày tạo</b></div>
                    <div class="col-md-4">
                        <input class='form-control form-control-sm from_ngaytao' placeholder="Từ ngày" type="date" />
                    </div>
                    <div class="col-md-4">
                        <input class='form-control form-control-sm to_ngaytao' placeholder="Đến ngày" type="date" />
                    </div>
                </div>
                <div class="boloc row mb-2 align-items-center">
                    <div class="col-md-4">Lọc theo: <b>Ngày hoàn thành</b></div>
                    <div class="col-md-4">
                        <input class='form-control form-control-sm from_ngayhoanthanh' placeholder="Từ ngày" type="date" />
                    </div>
                    <div class="col-md-4">
                        <input class='form-control form-control-sm to_ngayhoanthanh' placeholder="Đến ngày" type="date" />
                    </div>
                </div>
                <div class="boloc row mb-2 align-items-center">
                    <div class="col-md-4">Lọc theo: <b>Chưa đọc</b></div>
                    <div class="col-md-8">
                        <div class="custom-control custom-switch switch-primary">
                            <input type="checkbox" class="custom-control-input chuadoc" id="customSwitchchuadoc"
                                   value="true">
                            <label class="custom-control-label" for="customSwitchchuadoc"></label>
                        </div>
                    </div>
                </div>
            </form>
            <div class="text-center mt-3">
                <button class="btn btn-sm btn-secondary reset"><i class='fas fa-sync-alt mr-2'></i>Cài lại</button>
                <button class="btn btn-sm btn-success timkiem ml-3"><i class='fas fa-filter mr-2'></i>Tìm kiếm</button>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        var keyword = @Html.Raw(Json.Serialize(ViewData["keyword"]));
        var page = 'signdoc';
        var type = @Html.Raw(Json.Serialize(ViewData["type"]));
        $(document).ready(function () {
            let filter_cancle = localStorage.getItem('IGNORE_CANCLE');
            if (filter_cancle == 1) {
                $(".filter_cancle").attr("checked", true);
            }
            let table = $('#quanlytin').DataTable({
                "stateSave": true,
                "processing": true,
                "serverSide": true,
                // "ordering": false,
                "ajax": {
                    "url": "/admin/document/table",
                    "dataType": "json",
                    "type": "POST",
                    'data': function(data) {
                        data['type'] = "signdoc";

                        let search_code = $("#quanlytin_wrapper .code").val();
                        let search_mahoso = $("#quanlytin_wrapper .mahoso").val();
                        let search_name_vi = $("#quanlytin_wrapper .name_vi").val();
                        let search_type = $("#quanlytin_wrapper .search_type").val();
                        let search_status = $("#quanlytin_wrapper .search_status").val();
                        let search_priority = $("#quanlytin_wrapper .search_priority").val();
                        let search_type_option = $("#quanlytin_wrapper .search_type_option").val();
                        let search_from_ngaytao = $("#quanlytin_wrapper .from_ngaytao").val();
                        let search_to_ngaytao = $("#quanlytin_wrapper .to_ngaytao").val();
                        let search_from_ngayhoanthanh = $("#quanlytin_wrapper .from_ngayhoanthanh").val();
                        let search_to_ngayhoanthanh = $("#quanlytin_wrapper .to_ngayhoanthanh").val();
                        let filter_cancle = $(".filter_cancle").is(":checked");

                        let search_unread = $("#quanlytin_wrapper .chuadoc").is(":checked") ? "unread" : "";

                        data['search_code'] = search_code;
                        data['search_mahoso'] = search_mahoso;
                        data['search_name_vi'] = search_name_vi;
                        data['search_type'] = search_type;
                        data['search_status'] = search_status;
                        data['search_priority'] = search_priority;
                        data['search_type_option'] = search_type_option;
                        data['search_from_ngaytao'] = search_from_ngaytao;
                        data['search_to_ngaytao'] = search_to_ngaytao;
                        data['search_from_ngayhoanthanh'] = search_from_ngayhoanthanh;
                        data['search_to_ngayhoanthanh'] = search_to_ngayhoanthanh;
                        data['filter_cancle'] = filter_cancle;
                        data['search_unread'] = search_unread;
                    }
                },
                "columns": [{
                        "data": "priority",
                        "className": "text-center",
                        "width": "50px",
                        "orderable": false
                    },{
                        "data": "name",
                        "width": "800px",
                        "orderable": false
                    },{
                        "data": "user_signature",
                        "className": "text-center",
                        "orderable": false
                    },{
                        "data": "status",
                        "className": "text-center",
                        "orderable": false
                    }
                ],
                initComplete: function () {
                    $("body").trigger("table_load");
                    $(".dataTables_filter label").addClass("d-none");
                    $(".dataTables_filter label input").addClass("d-none");
                    $(".dataTables_filter").before("<div style='align-items: center;justify-content: end;display: flex;height: 100%;'><a href='#' id='btnOpen'><i class='fas fa-filter'></i> Tìm kiếm</a></div>");

                    var $btn = $('#btnOpen');
                    $btn.wrap('<div class="dropdown dropleft d-inline-block" id="dropdownBoloc"></div>');
                   // Gắn template
                    var tpl = $('#tplDropdown').html();
                    $btn.after(tpl);

                    // Kích hoạt dropdown
                    $btn.attr('data-toggle', 'dropdown');

                    $('.dropdown-menu').on('click', function (e) {
                        e.stopPropagation();
                    });
                    $(".themboloc").click((e)=>{
                        var template =$("#tplDropdown .boloc").prop('outerHTML');
                        $("#dropdownBoloc .formtimkiem").append(template);
                    })

                    var html_type = "<option value='0'></option>";
                    for (var t of type) {
                        html_type += "<option value='" + t.id + "'>" + t.name + "</option>";
                    }
                    $("#quanlytin_wrapper .search_type_option").html(html_type);


                    $(".reset").click(function () {
                        $('#dropdownBoloc .formtimkiem')[0].reset();
                        table.ajax.reload();
                    });
                     $(".timkiem").click(function () {
                        table.ajax.reload();
                    });
                },
            });
            $(document).on("click", ".huy", function () {
                let id = $(this).data("id");
                $("#cancle_reason [name='id']").val(id);
            });

            $(document).on("click", ".filter_cancle", function () {
                let search = +$(this).is(":checked");
                localStorage.setItem('IGNORE_CANCLE', search);
                table.ajax.reload();
            })
        });
    </script>
}
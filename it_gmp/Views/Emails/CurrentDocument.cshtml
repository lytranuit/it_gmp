@{
    ViewData["Title"] = "Index";
    Layout = null;
}
<table style="width:100%">
    <tbody>
        <tr>
            <td>
                <div>
                    <div style="box-sizing:border-box;margin:0;">
                        <p style="text-align:left">Kính gửi anh / chị,</p>
                        <p style="text-align:left">Thông báo hồ sơ đã phê duyệt:</p>

                        <p style="text-align:left"><b>@Model.title</b></p>
                        <p style="text-align:left"> - Ngày phê duyệt: @Model.date_finish.ToString("dd/MM/yyyy")</p>
                        <p style="text-align:left"> - Ngày hiệu lực: @Model.date_effect.ToString("dd/MM/yyyy")</p>

                        <p style="text-align:left"><b>Nội dung mô tả thay đổi:</b></p>
                        <p style="text-align:left;white-space:pre-line">@Model.note</p>
                        @if (@Model.type_id == 82)
                        {
                            <p style="text-align:left">Nhờ các Anh/Chị phụ trách đào tạo của các bộ phận hoàn thiện hồ sơ đào tạo đầy đủ cho SOP liên quan đến bộ phận.<b>(Theo file đính kèm)</b></p>
                            <p style="text-align:left">Nhờ các Anh/Chị Trưởng bộ phận thông báo, cho nhân viên áp dụng SOP này từ ngày có hiệu lực.</p>

                        }

                        <p style="text-align:left">Trân trọng,</p>
                        <p style="text-align:left">E-signature System</p>
                        <br>
                    </div>
                </div>
            </td>
        </tr>
    </tbody>
</table>
@{
    ViewData["Title"] = "Index";
    Layout = null;
}
<center>
    <table>
        <tbody>
            <tr>
                <td width="600">
                    <div>

                        @* <p style="text-align:center;margin-bottom:30px">
                            <img style="border:0;height:auto;line-height:100%;outline:none;text-decoration:none;width:400px;" src="@Model.link_logo" />
                        </p> *@
                        <div style="background: linear-gradient(135deg, #e74c3c, #e67e22); padding: 20px 30px; border-radius: 8px 8px 0 0; text-align: center;">
                            <h1 style="color: #ffffff; margin: 0; font-size: 20px; font-weight: bold; letter-spacing: 0.5px;">⚠️ NHẮC NHỞ: HỒ SƠ SẮP ĐẾN HẠN HIỆU LỰC</h1>
                        </div>
                        <div style="box-sizing:border-box;margin:0;padding:20px 40px; border: 1px solid #e0e0e0; border-top: none; border-radius: 0 0 8px 8px;">
                            <h2 style="text-align:left">Xin chào,</h2>
                            <p style="text-align:left">Hệ thống chữ ký điện tử ASTA có <strong style="color:#e74c3c; font-size:18px;">@Model.count</strong> hồ sơ chưa hoàn thành khi sắp đến hạn hiệu lực:</p>
                            <table style="width:100%">
                                <thead style="background:#f1f5fa;">
                                    <tr>
                                        <td style="padding:10px;">Mã</td>
                                        <td style="padding:10px;">Tên</td>
                                        <td style="padding:10px;">Ngày hiệu lực</td>
                                        <td style="padding:10px;">Link</td>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.data)
                                    {
                                        <tr>
                                            <td style="padding:10px;">@item.code</td>
                                            <td style="padding:10px;">@item.name_vi</td>
                                            <td style="padding:10px;">@item.date_effect.ToString("dd/MM/yyyy")</td>
                                            <td style="padding:10px;"><a href="@(Model.Domain + "/admin/document/details/")@item.id" class="btn btn-sm btn-success text-white">Xem chi tiết</a></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <p style="text-align:left">Trân trọng.</p>
                            <p style="text-align:left">ASTA</p>
                            <br>
                        </div>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</center>
@* <script src="~/lib/vue/vue.js"></script> *@
<div id="popup-khuvuc">
    <div id="modalKhuvuc" class="modal" tabindex="-1" role="dialog" data-backdrop="static">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 mb-3">
                            <h5 class="modal-title">
                                Chọn bộ phận
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </h5>
                        </div>
                        <div class="col-12 mt-3">
                            <div v-for="khuvuc in groups" :key="khuvuc.makhuvuc" style="margin-left: 20px;padding: 10px;margin-bottom: 5px;">
                                <a href="#" v-on:click="select(khuvuc)">{{khuvuc.tenkhuvuc}}</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    var popup = new Vue({
        el: '#popup-khuvuc',
        //store:store,
        data: {
            groups: [],
            selected: "-1",
            search: "",
        },
        computed: {
            //scene() {
            //    return store.state.scene;
            //}
        },
        mounted() {
            var that = this;
            $('#modalKhuvuc').on('show.bs.modal', function (e) {
                that.loadData();
            });
        },
        methods: {
            loadData() {
                var that = this;
                if (that.groups.length === 0) {
                    $.ajax({
                        url: "/admin/home/list_khuvuc",
                        success: function (data) {
                            that.groups = data;
                        }
                    });
                }
            },
            select(data) {
                // console.log(data);
                $("#modalKhuvuc").modal("hide");
                // console.log($("#modalKhuvuc").data("select"))
                var id_select = $("#modalKhuvuc").data("select");
                var values = $("#"+id_select).val() || []; // trả về array
                var listEmail = data.list_email_SOP_id;
                if (listEmail && listEmail.length > 0) {
                    listEmail.forEach(v => {
                        if (!values.includes(v)) {
                            values.push(v);
                        }
                    });
                }else{
                    alert("Không có Email nào!");
                    return;
                }

                // console.log(values)
                $("#"+id_select).val(values).trigger('chosen:updated');
            }
        },
    });
</script>